{
  "manifest_version": 3,
  "name": "WISS Stundenplan",
  "short_name": "Stundenplan",
  "version": "1.10.1",
  "description": "Dein WISS-Stundenplan ohne Warten. Zeigt sofort die letzten Daten und lädt im Hintergrund neu.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://wiss.tocco.ch/*",
    "https://www.modulbaukasten.ch/*",
    "https://ictbb.crm17.dynamics.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WISS Stundenplan",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wiss.tocco.ch/extranet/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wiss-stundenplan@wiss-tools",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/Nicolas-Wehrle/Wiss-Stundenplan/main/updates.json"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
